@startuml Архитектура_АгроТех_Системы_С3_альтер

!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_TOP_DOWN()

Person(operator, "Дежурный сотрудник", "Мониторинг данных")

System_Boundary(платформа, "АгроПром Х - Цифровая платформа мониторинга скота") {

    Container_Boundary(сервер_агент, "Сервер-агент") {

        Container_Boundary(видеомониторинг, "Видеомониторинг скота") {
            Container(запись_скота, "Прием видео потоков", "Python", "Камеры на ферме")
        }

        Container_Boundary(датчики, "Датчики оборудования на фермах") {
            Container(кормушки, "Система управления кормушками", "Python", "Управление кормушками разных производителей")
            Container(данные_кормушек, "Унификация данных с кормушек", "Python", "Нормализует телеметрию и статусы кормушек")

            Container(поилки, "Система управления поилками", "Python", "Управление поилками разных производителей")
            Container(данные_поилок, "Унификация данных с поилок", "Python", "Нормализует телеметрию и статусы поилок")

            Container(вода, "Система фильтрации воды", "Python", "Передает состояние и сигналы фильтрации")
            Container(запасы_еды, "Система управления запасами еды", "C#", "Отслеживает остатки корма")

            Container(scada, "SCADA система", "Ignition", "Управление оборудованием на фермах")
        }

        Container_Boundary(уведомления, "Уведомление персонала на местах") {
            Container(notification_ui, "Интерфейс мониторинга инцидентов", "React", "Отображает тревоги и уведомления дежурному сотруднику")
        }

        Container_Boundary(iot_платформа, "IoT платформа") {
            Container(iot_шлюз, "IoT шлюз", "Node-RED", "Сбор, маршрутизация и передача телеметрии, видеоданных и событий с фермы")
            ContainerDb(tsdb, "База временных рядов", "TimescaleDB", "Данные датчиков и локальная история")
            ContainerDb(локальный_буфер_событий, "Локальный буфер событий", "SQLite / Redis", "Хранит телеметрию и события при отсутствии связи")
            Container(менеджер_синхронизации, "Менеджер синхронизации", "Python / Node-RED", "Повторно передает накопленные данные после восстановления связи")
        }

        Container(локальный_сервис_восстановления, "Локальный сервис восстановления", "systemd / supervisor", "Контролирует состояние сервисов на ферме и перезапускает их при сбоях")
    }

    Container_Boundary(центр, "Центральный сервер") {
        Container(auth_service, "Сервис авторизации", "OAuth 2.0 / OIDC", "Аутентификация пользователей, управление ролями и правами доступа")
        Container(api_gateway, "API Gateway", "REST / HTTPS", "Единая точка доступа для web- и mobile-приложений, предоставляет данные мониторинга, инцидентов, метрик и команд управления")

        Container_Boundary(видеомониторинг_центр, "Видеомониторинг скота") {
            Container(видео_адаптер, "Обработка видео", "C#", "Унификация видео с камер")
        }

        Container_Boundary(ИИ_сервис, "ИИ сервис") {
            Container(CV_model, "CV model", "Python / PyTorch", "Видеоаналитика и обнаружение инцидентов, включая беспокойство, драки, задавливание поросят, болезнь, гибель и подсчет поголовья")
        }

        Container(kafka, "Брокер сообщений", "Apache Kafka cluster", "Кластерная шина данных")
        Container(аналитика, "Аналитический модуль", "Python", "Анализ эффективности, агрегация показателей и поддержка пользовательских метрик")
        Container(сервис_прогнозирования_расхода_еды, "Сервис прогнозирования расхода еды", "Python", "Прогнозирует расход корма и срок исчерпания запасов")
        Container(сервис_мониторинга_и_отказоустойчивости, "Сервис мониторинга и отказоустойчивости", "Prometheus + Alertmanager", "Контролирует состояние сервисов и инфраструктуры, обнаруживает сбои")
        Container(bi, "BI система", "Power BI", "Отчеты и визуализация")

        ContainerDb(data_lake, "Data Lake", "MinIO (replicated)", "Сырые данные, логи и видеоартефакты")
        ContainerDb(dwh, "Data Warehouse", "ClickHouse cluster", "Структурированные данные и витрины")
    }

    Rel(запись_скота, iot_шлюз, "Передает видеоданные", "RTSP / ONVIF")
    Rel(iot_шлюз, видео_адаптер, "Передает видеоданные в центр", "gRPC / RTSP over VPN")
    Rel(видео_адаптер, CV_model, "Передача видео-данных", "gRPC")

    Rel(CV_model, notification_ui, "Передает тревоги и инциденты", "WebSocket")
    Rel(operator, notification_ui, "Мониторинг данных", "HTTPS")

    Rel(CV_model, kafka, "Передает события и метрики", "Kafka Protocol")

    Rel(кормушки, данные_кормушек, "Передает телеметрию и статусы", "Modbus TCP")
    Rel(данные_кормушек, scada, "Передает нормализованные данные", "Modbus TCP")

    Rel(поилки, данные_поилок, "Передает телеметрию и статусы", "Modbus TCP")
    Rel(данные_поилок, scada, "Передает нормализованные данные", "Modbus TCP")

    Rel(вода, scada, "Передача сигнала", "Modbus TCP")
    Rel(запасы_еды, scada, "Передача сигнала", "Modbus TCP")

    Rel(scada, tsdb, "Записывает локальные временные ряды", "SQL / TCP")
    Rel(scada, iot_шлюз, "Передает данные датчиков с оборудования", "OPC UA")
    Rel(iot_шлюз, kafka, "Передает телеметрию и события", "Kafka Protocol")

    Rel(iot_шлюз, локальный_буфер_событий, "Буферизует телеметрию и события при отсутствии связи", "Local write")
    Rel(менеджер_синхронизации, локальный_буфер_событий, "Читает накопленные данные", "SQL / Local read")
    Rel(менеджер_синхронизации, kafka, "Повторно передает данные после восстановления связи", "Kafka Protocol")

    Rel(локальный_сервис_восстановления, запись_скота, "Контролирует состояние и перезапускает при сбое")
    Rel(локальный_сервис_восстановления, iot_шлюз, "Контролирует состояние и перезапускает при сбое")
    Rel(локальный_сервис_восстановления, notification_ui, "Контролирует состояние интерфейса")
    Rel(локальный_сервис_восстановления, менеджер_синхронизации, "Контролирует синхронизацию")

    Rel(kafka, data_lake, "Сырые данные", "Kafka Connect + S3")
    Rel(kafka, dwh, "Трансформированные данные", "ETL + Airflow")

    Rel(dwh, аналитика, "Предоставляет структурированные данные", "SQL")
    Rel(dwh, сервис_прогнозирования_расхода_еды, "Предоставляет историю расхода и остатков", "SQL")
    Rel(сервис_прогнозирования_расхода_еды, аналитика, "Передает прогнозы и аномалии расхода", "REST / gRPC")

    Rel(аналитика, api_gateway, "Передача данных по сети интернет", "REST")
    Rel(сервис_прогнозирования_расхода_еды, api_gateway, "Передает прогнозы расхода еды", "REST")
    Rel(аналитика, bi, "Передает отчеты", "ODBC")
    Rel(сервис_прогнозирования_расхода_еды, bi, "Передает прогнозные показатели", "ODBC")

    Rel(notification_ui, auth_service, "Авторизация в системе", "HTTPS, OAuth 2.0, OIDC")

    Rel(сервис_мониторинга_и_отказоустойчивости, kafka, "Мониторит состояние брокера и лаги")
    Rel(сервис_мониторинга_и_отказоустойчивости, data_lake, "Мониторит доступность и репликацию")
    Rel(сервис_мониторинга_и_отказоустойчивости, dwh, "Мониторит состояние кластера и реплик")
    Rel(сервис_мониторинга_и_отказоустойчивости, api_gateway, "Мониторит доступность API")
    Rel(сервис_мониторинга_и_отказоустойчивости, аналитика, "Мониторит выполнение аналитических задач")
    Rel(сервис_мониторинга_и_отказоустойчивости, auth_service, "Мониторит авторизацию и токены")
    Rel(сервис_мониторинга_и_отказоустойчивости, видео_адаптер, "Мониторит обработку видео")
    Rel(сервис_мониторинга_и_отказоустойчивости, CV_model, "Мониторит inference и latency")
}

@enduml